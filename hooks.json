{
  "token-behavior-collector": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./bin/hook_collector.py",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python ./bin/hook_collector.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./bin/hook_collector.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./bin/hook_collector.py",
        "timeout": 10
      }
    ]
  }
}
